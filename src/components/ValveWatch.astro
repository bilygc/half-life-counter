---
import { valveActivities } from "../data/valveWatch";
---

<script>
    import AOS from "aos";
    import "aos/dist/aos.css";

    AOS.init();
</script>

<section class="valve-watch">
    <div class="section-header">
        <div class="header-line"></div>
        <h2>
            <span class="pulse-dot"></span>
            Valve Watch
        </h2>
        <div class="header-line"></div>
    </div>
    <p class="section-subtitle">
        Monitoring Valve's latest moves for signs of Half-Life 3.
    </p>

    <div class="activity-feed">
        {
            valveActivities.map((activity, index) => (
                <div
                    class="activity-item"
                    data-aos="fade-up"
                    data-aos-delay={index * 80}
                >
                    <div class="activity-icon">{activity.icon}</div>
                    <div class="activity-body">
                        <div class="activity-meta">
                            <span class="activity-label">{activity.label}</span>
                            <span class="activity-date">{activity.date}</span>
                        </div>
                        <h4 class="activity-title">{activity.title}</h4>
                        <p class="activity-detail">{activity.detail}</p>
                    </div>
                    {activity.url && (
                        <a
                            href={activity.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="activity-link"
                            aria-label={`View source for ${activity.title}`}
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M7 7h10v10" />
                                <path d="M7 17 17 7" />
                            </svg>
                        </a>
                    )}
                </div>
            ))
        }
    </div>
</section>

<style>
    .valve-watch {
        width: 100%;
        max-width: 800px;
        margin: 4rem auto;
        padding: 0 1rem;
        color: var(--hl-accent);
    }

    .section-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 0.75rem;
    }

    .header-line {
        flex: 1;
        height: 1px;
        background: linear-gradient(
            to right,
            transparent,
            var(--hl-secondary),
            transparent
        );
    }

    h2 {
        font-size: 1.5rem;
        color: var(--hl-primary);
        text-transform: uppercase;
        letter-spacing: 0.15em;
        text-shadow: 0 0 10px rgba(212, 120, 0, 0.3);
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .pulse-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        background: #44ff44;
        border-radius: 50%;
        box-shadow: 0 0 6px #44ff44;
        animation: pulse-glow 2s infinite ease-in-out;
    }

    @keyframes pulse-glow {
        0%,
        100% {
            opacity: 0.6;
            box-shadow: 0 0 4px #44ff44;
        }
        50% {
            opacity: 1;
            box-shadow: 0 0 12px #44ff44;
        }
    }

    .section-subtitle {
        text-align: center;
        color: var(--hl-text-dim);
        font-size: 0.9rem;
        font-weight: 300;
        margin-bottom: 2rem;
    }

    .activity-feed {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .activity-item {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        background: rgba(10, 6, 0, 0.6);
        border: 1px solid var(--hl-secondary);
        padding: 1.25rem;
        border-radius: 6px;
        transition: all 0.3s ease;
        position: relative;
    }

    .activity-item:hover {
        border-color: var(--hl-primary);
        box-shadow: 0 0 15px rgba(212, 120, 0, 0.1);
        transform: translateY(-2px);
    }

    .activity-icon {
        font-size: 1.5rem;
        flex-shrink: 0;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(212, 120, 0, 0.08);
        border-radius: 8px;
        border: 1px solid rgba(212, 120, 0, 0.15);
    }

    .activity-body {
        flex: 1;
        min-width: 0;
    }

    .activity-meta {
        display: flex;
        gap: 0.75rem;
        align-items: center;
        margin-bottom: 0.35rem;
    }

    .activity-label {
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--hl-primary);
        background: rgba(212, 120, 0, 0.1);
        padding: 1px 6px;
        border-radius: 3px;
    }

    .activity-date {
        font-size: 0.75rem;
        color: var(--hl-text-dim);
    }

    .activity-title {
        font-size: 1rem;
        color: var(--hl-glow);
        margin-bottom: 0.25rem;
    }

    .activity-detail {
        font-size: 0.85rem;
        line-height: 1.5;
        color: #bbb;
        font-weight: 300;
    }

    .activity-link {
        flex-shrink: 0;
        color: var(--hl-text-dim);
        transition: color 0.2s;
        align-self: center;
    }

    .activity-link:hover {
        color: var(--hl-primary);
    }

    @media (min-width: 769px) {
        h2 {
            font-size: 2rem;
        }
    }
</style>
