---
import type { Article } from "../pages/index.astro";
interface Props {
  articles: Article[];
  error: string | null;
}

const { articles, error } = Astro.props;
---

<script>
  import AOS from "aos";
  import "aos/dist/aos.css";

  AOS.init();
</script>
<section class="news-section">
  <h2>Latest News</h2>

  {
    error && (
      <div class="error-message">
        Failed to load news: {error}. Is the API running?
      </div>
    )
  }

  {
    !error && articles.length === 0 && (
      <div class="loading">Loading news...</div>
    )
  }

  <div class="news-list">
    {
      articles.map((article, index) => {
        if (index === 0) {
          return;
        }
        return (
          <article
            class="news-item"
            data-aos={`fade-${index % 2 === 0 ? "left" : "right"}`}
            data-aos-delay={index * 100}
          >
            <div class="news-content">
              <h3>
                <a href={article.url} target="_blank" rel="noopener noreferrer">
                  {article.title}
                </a>
              </h3>
              <div class="news-meta">
                <span class="news-source">{article.source.name}</span>
                <span class="news-date">
                  {new Date(article.publishedAt).toLocaleDateString()}
                </span>
              </div>
              <p>{article.description}</p>
            </div>
            {article.urlToImage && (
              <div class="news-image">
                <img
                  src={article.urlToImage}
                  alt={article.title}
                  loading="lazy"
                />
              </div>
            )}
          </article>
        );
      })
    }
  </div>
</section>

<style>
  .news-section {
    width: 100%;
    max-width: 800px;
    margin: 4rem auto;
    padding: 0 1rem;
    color: var(--hl-accent);
    overflow-x: hidden;
  }

  h2 {
    font-size: 2rem;
    color: var(--hl-primary);
    margin-bottom: 2rem;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-shadow: 0 0 10px rgba(212, 120, 0, 0.3);
  }

  .news-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .news-item {
    display: flex;
    gap: 2rem;
    background: rgba(10, 6, 0, 0.6);
    border: 1px solid var(--hl-secondary);
    padding: 1.5rem;
    border-radius: 4px;
    transition: all 0.3s ease;
  }

  .news-item:hover {
    border-color: var(--hl-primary);
    box-shadow: 0 0 15px rgba(212, 120, 0, 0.1);
    transform: translateY(-2px);
  }

  .news-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  h3 {
    font-size: 1.25rem;
    margin: 0;
    line-height: 1.4;
  }

  h3 a {
    color: var(--hl-glow);
    text-decoration: none;
    transition: color 0.2s;
  }

  h3 a:hover {
    color: var(--hl-primary);
  }

  .news-meta {
    font-size: 0.875rem;
    color: var(--hl-text-dim);
    display: flex;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .news-source {
    color: var(--hl-primary);
    font-weight: 500;
  }

  p {
    margin: 0;
    line-height: 1.6;
    color: #ccc;
  }

  .news-image {
    flex-shrink: 0;
    width: 200px;
    height: 120px;
    border-radius: 4px;
    overflow: hidden;
    background: #222;
  }

  .news-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .error-message {
    color: #ff4444;
    text-align: center;
    padding: 2rem;
    background: rgba(255, 68, 68, 0.1);
    border-radius: 4px;
  }

  @media (max-width: 768px) {
    .news-item {
      flex-direction: column-reverse;
      gap: 1rem;
    }

    .news-image {
      width: 100%;
      height: 200px;
    }
  }
</style>
