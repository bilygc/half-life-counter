---
import type { EvidenceItem } from "../data/evidence";

interface Props {
    evidence: EvidenceItem;
}

const { evidence } = Astro.props;

const credibilityColors = {
    confirmed: "#059669",
    plausible: "#2563eb",
    speculative: "#d97706",
    debunked: "#dc2626",
};
---

<div
    class="evidence-card"
    data-category={evidence.category}
    data-credibility={evidence.credibility}
    data-aos="fade-up"
>
    <div class="card-header">
        <div class="badges">
            <span
                class="credibility-badge"
                style={`background: ${credibilityColors[evidence.credibility]}`}
            >
                {evidence.credibility}
            </span>
            <span class="category-badge">{evidence.category}</span>
        </div>
        <span class="date">{evidence.date}</span>
    </div>

    <h3 class="title">{evidence.title}</h3>
    <p class="description">{evidence.description}</p>

    <div class="card-footer">
        <span class="source">Source: {evidence.source}</span>
        {
            evidence.sourceUrl && (
                <a
                    href={evidence.sourceUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="intel-link"
                >
                    Access Intel
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <>
                            <path d="M7 7h10v10" />
                            <path d="M7 17 17 7" />
                        </>
                    </svg>
                </a>
            )
        }
    </div>

    <div class="card-glow"></div>
</div>

<style>
    .evidence-card {
        background: rgba(10, 6, 0, 0.7);
        border: 1px solid var(--hl-secondary);
        padding: 1.5rem;
        border-radius: 8px;
        position: relative;
        overflow: hidden;
        backdrop-filter: blur(10px);
        display: flex;
        flex-direction: column;
        gap: 1rem;
        transition: all 0.3s ease;
    }

    .evidence-card:hover {
        border-color: var(--hl-primary);
        transform: translateY(-4px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
    }

    .evidence-card:hover .card-glow {
        opacity: 0.1;
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .badges {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .credibility-badge {
        font-size: 10px;
        font-weight: 900;
        text-transform: uppercase;
        padding: 2px 8px;
        border-radius: 4px;
        color: #fff;
        letter-spacing: 0.5px;
    }

    .category-badge {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        padding: 2px 8px;
        border-radius: 4px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: var(--hl-text-dim);
        letter-spacing: 0.5px;
    }

    .date {
        font-size: 0.75rem;
        color: var(--hl-text-dim);
        font-weight: 500;
    }

    .title {
        font-size: 1.25rem;
        color: var(--hl-glow);
        margin: 0;
        letter-spacing: 0.5px;
    }

    .description {
        font-size: 0.9rem;
        line-height: 1.6;
        color: #ccc;
        font-weight: 300;
        flex-grow: 1;
    }

    .card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid rgba(212, 120, 0, 0.1);
        padding-top: 1rem;
        margin-top: 0.5rem;
    }

    .source {
        font-size: 0.8rem;
        color: var(--hl-primary);
        font-weight: 600;
    }

    .intel-link {
        font-size: 0.8rem;
        color: var(--hl-accent);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 0.25rem;
        font-weight: 700;
        text-transform: uppercase;
        transition: color 0.2s;
    }

    .intel-link:hover {
        color: var(--hl-primary);
    }

    .card-glow {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: radial-gradient(
            circle at top left,
            var(--hl-primary),
            transparent 70%
        );
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }
</style>
