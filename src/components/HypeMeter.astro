---
import { hypeFactors, computeHypeLevel, getHypeClassification } from "../data/hypeMeter";

const hypeScore = computeHypeLevel(hypeFactors);
const classification = getHypeClassification(hypeScore);

// SVG arc calculations for a semicircle gauge
const radius = 120;
const circumference = Math.PI * radius; // half circle
const offset = circumference - (hypeScore / 100) * circumference;

const statusIcons: Record<string, { symbol: string; color: string }> = {
    rising: { symbol: "▲", color: "#44ff44" },
    stable: { symbol: "●", color: "#ffbb00" },
    declining: { symbol: "▼", color: "#ff4444" },
};
---

<script>
    import AOS from "aos";
    import "aos/dist/aos.css";
    AOS.init();
</script>

<section class="hype-meter">
    <!-- Gauge Section -->
    <div class="gauge-container" data-aos="zoom-in">
        <svg class="gauge-svg" viewBox="0 0 280 160" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="gaugeGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#2288ff" />
                    <stop offset="25%" stop-color="#44cc44" />
                    <stop offset="50%" stop-color="#ffbb00" />
                    <stop offset="75%" stop-color="#ff8800" />
                    <stop offset="100%" stop-color="#ff2222" />
                </linearGradient>
                <filter id="glow">
                    <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
                    <feMerge>
                        <feMergeNode in="coloredBlur"/>
                        <feMergeNode in="SourceGraphic"/>
                    </feMerge>
                </filter>
            </defs>

            <!-- Background arc -->
            <path
                class="gauge-bg"
                d="M 20 140 A 120 120 0 0 1 260 140"
                fill="none"
                stroke="rgba(94, 58, 26, 0.3)"
                stroke-width="16"
                stroke-linecap="round"
            />

            <!-- Active arc -->
            <path
                class="gauge-fill"
                d="M 20 140 A 120 120 0 0 1 260 140"
                fill="none"
                stroke="url(#gaugeGradient)"
                stroke-width="16"
                stroke-linecap="round"
                stroke-dasharray={circumference}
                stroke-dashoffset={circumference}
                data-target-offset={offset}
                filter="url(#glow)"
            />

            <!-- Tick marks -->
            {[0, 25, 50, 75, 100].map((tick) => {
                const angle = Math.PI - (tick / 100) * Math.PI;
                const x1 = 140 + 105 * Math.cos(angle);
                const y1 = 140 - 105 * Math.sin(angle);
                const x2 = 140 + 95 * Math.cos(angle);
                const y2 = 140 - 95 * Math.sin(angle);
                const labelX = 140 + 85 * Math.cos(angle);
                const labelY = 140 - 85 * Math.sin(angle);
                return (
                    <g>
                        <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="rgba(212, 120, 0, 0.4)" stroke-width="2" />
                        <text x={labelX} y={labelY} fill="rgba(212, 120, 0, 0.6)" font-size="10" text-anchor="middle" dominant-baseline="middle">{tick}</text>
                    </g>
                );
            })}
        </svg>

        <!-- Score display overlaying the gauge -->
        <div class="score-display">
            <span class="score-number" data-target={hypeScore}>0</span>
            <span class="score-label" style={`color: ${classification.color}; text-shadow: 0 0 15px ${classification.color}40;`}>
                {classification.label}
            </span>
            <span class="score-subtitle">THREAT LEVEL</span>
        </div>
    </div>

    <!-- Factor Cards -->
    <div class="factors-grid">
        {hypeFactors.map((factor, index) => {
            const status = statusIcons[factor.status];
            return (
                <div
                    class="factor-card"
                    data-aos="fade-up"
                    data-aos-delay={index * 60}
                >
                    <div class="factor-header">
                        <span class="factor-icon">{factor.icon}</span>
                        <div class="factor-title-group">
                            <h3 class="factor-name">{factor.name}</h3>
                            <span class="factor-date">{factor.lastUpdate}</span>
                        </div>
                        <div class="factor-status" style={`color: ${status.color};`}>
                            <span class="status-icon">{status.symbol}</span>
                            <span class="status-label">{factor.status}</span>
                        </div>
                    </div>
                    <p class="factor-description">{factor.description}</p>
                    <div class="factor-bar-container">
                        <div class="factor-bar-bg">
                            <div
                                class="factor-bar-fill"
                                data-weight={factor.weight}
                                style={`--target-width: ${factor.weight}%;`}
                            >
                            </div>
                        </div>
                        <span class="factor-weight">{factor.weight}/100</span>
                    </div>
                </div>
            );
        })}
    </div>

    <!-- Summary Footer -->
    <div class="hype-summary" data-aos="fade-up">
        <div class="summary-stat">
            <span class="stat-value">{hypeFactors.filter(f => f.status === "rising").length}</span>
            <span class="stat-label">Rising Signals</span>
        </div>
        <div class="summary-divider"></div>
        <div class="summary-stat">
            <span class="stat-value">{hypeFactors.length}</span>
            <span class="stat-label">Active Factors</span>
        </div>
        <div class="summary-divider"></div>
        <div class="summary-stat">
            <span class="stat-value">{hypeScore}<span class="stat-unit">%</span></span>
            <span class="stat-label">Global Hype Index</span>
        </div>
    </div>
</section>

<script>
    function setupHypeMeter() {
        // Animate gauge fill
        const gaugeFill = document.querySelector(".gauge-fill") as SVGPathElement | null;
        if (gaugeFill) {
            const targetOffset = parseFloat(gaugeFill.dataset.targetOffset || "0");
            setTimeout(() => {
                gaugeFill.style.transition = "stroke-dashoffset 2s cubic-bezier(0.25, 0.46, 0.45, 0.94)";
                gaugeFill.style.strokeDashoffset = String(targetOffset);
            }, 300);
        }

        // Animate score counter
        const scoreEl = document.querySelector(".score-number") as HTMLElement | null;
        if (scoreEl) {
            const target = parseInt(scoreEl.dataset.target || "0", 10);
            let current = 0;
            const duration = 2000;
            const start = performance.now();

            function animate(now: number) {
                const elapsed = now - start;
                const progress = Math.min(elapsed / duration, 1);
                // Ease out cubic
                const eased = 1 - Math.pow(1 - progress, 3);
                current = Math.round(eased * target);
                if (scoreEl) scoreEl.textContent = String(current);
                if (progress < 1) requestAnimationFrame(animate);
            }
            setTimeout(() => requestAnimationFrame(animate), 300);
        }

        // Animate factor bars
        const bars = document.querySelectorAll(".factor-bar-fill") as NodeListOf<HTMLElement>;
        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    const el = entry.target as HTMLElement;
                    el.style.width = el.style.getPropertyValue("--target-width");
                    observer.unobserve(el);
                }
            });
        }, { threshold: 0.3 });

        bars.forEach((bar) => {
            bar.style.width = "0%";
            observer.observe(bar);
        });
    }

    document.addEventListener("astro:page-load", setupHypeMeter);
</script>

<style>
    .hype-meter {
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    /* ── Gauge ── */
    .gauge-container {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 3rem;
    }

    .gauge-svg {
        width: 100%;
        max-width: 400px;
        height: auto;
    }

    .gauge-bg {
        opacity: 0.5;
    }

    .score-display {
        position: absolute;
        bottom: 10px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.15rem;
    }

    .score-number {
        font-size: 4rem;
        font-weight: 700;
        color: var(--hl-glow);
        text-shadow: 0 0 20px rgba(255, 180, 0, 0.5);
        line-height: 1;
    }

    .score-label {
        font-size: 1.4rem;
        font-weight: 700;
        letter-spacing: 6px;
        text-transform: uppercase;
        animation: pulse-label 3s ease-in-out infinite;
    }

    .score-subtitle {
        font-size: 0.7rem;
        color: var(--hl-text-dim);
        letter-spacing: 4px;
        text-transform: uppercase;
    }

    @keyframes pulse-label {
        0%, 100% { opacity: 0.8; }
        50% { opacity: 1; }
    }

    /* ── Factor Cards ── */
    .factors-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 1rem;
        margin-bottom: 3rem;
    }

    .factor-card {
        background: rgba(10, 6, 0, 0.6);
        border: 1px solid var(--hl-secondary);
        border-radius: 8px;
        padding: 1.25rem;
        transition: all 0.3s ease;
    }

    .factor-card:hover {
        border-color: var(--hl-primary);
        box-shadow: 0 0 20px rgba(212, 120, 0, 0.12);
        transform: translateY(-3px);
    }

    .factor-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
    }

    .factor-icon {
        font-size: 1.5rem;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(212, 120, 0, 0.08);
        border-radius: 8px;
        border: 1px solid rgba(212, 120, 0, 0.15);
        flex-shrink: 0;
    }

    .factor-title-group {
        flex: 1;
        min-width: 0;
    }

    .factor-name {
        font-size: 0.95rem;
        color: var(--hl-glow);
        font-weight: 700;
        margin: 0;
    }

    .factor-date {
        font-size: 0.7rem;
        color: var(--hl-text-dim);
    }

    .factor-status {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.1rem;
        flex-shrink: 0;
    }

    .status-icon {
        font-size: 0.8rem;
    }

    .status-label {
        font-size: 0.6rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 700;
    }

    .factor-description {
        font-size: 0.82rem;
        color: #bbb;
        line-height: 1.5;
        font-weight: 300;
        margin-bottom: 0.75rem;
    }

    .factor-bar-container {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .factor-bar-bg {
        flex: 1;
        height: 6px;
        background: rgba(94, 58, 26, 0.3);
        border-radius: 3px;
        overflow: hidden;
    }

    .factor-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--hl-primary), var(--hl-glow));
        border-radius: 3px;
        transition: width 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        box-shadow: 0 0 8px rgba(255, 180, 0, 0.3);
    }

    .factor-weight {
        font-size: 0.75rem;
        color: var(--hl-primary);
        font-weight: 700;
        white-space: nowrap;
        min-width: 45px;
        text-align: right;
    }

    /* ── Summary Footer ── */
    .hype-summary {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 2rem;
        padding: 1.5rem 2rem;
        background: rgba(10, 6, 0, 0.6);
        border: 1px solid var(--hl-secondary);
        border-radius: 8px;
        margin-bottom: 2rem;
    }

    .summary-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.25rem;
    }

    .stat-value {
        font-size: 2rem;
        font-weight: 700;
        color: var(--hl-glow);
        text-shadow: 0 0 10px rgba(255, 180, 0, 0.3);
        line-height: 1;
    }

    .stat-unit {
        font-size: 1rem;
        color: var(--hl-primary);
    }

    .stat-label {
        font-size: 0.7rem;
        color: var(--hl-text-dim);
        text-transform: uppercase;
        letter-spacing: 2px;
        font-weight: 700;
    }

    .summary-divider {
        width: 1px;
        height: 40px;
        background: var(--hl-secondary);
    }

    /* ── Responsive ── */
    @media (max-width: 768px) {
        .factors-grid {
            grid-template-columns: 1fr;
        }

        .score-number {
            font-size: 3rem;
        }

        .score-label {
            font-size: 1rem;
            letter-spacing: 4px;
        }

        .hype-summary {
            gap: 1rem;
            padding: 1rem;
        }

        .stat-value {
            font-size: 1.5rem;
        }

        .stat-label {
            font-size: 0.6rem;
            letter-spacing: 1px;
        }

        .gauge-svg {
            max-width: 300px;
        }
    }
</style>
