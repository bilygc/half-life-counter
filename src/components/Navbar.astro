---
const { pathname } = Astro.url;
const isHome = pathname === "/";
---

<nav class="navbar">
  <div class="nav-container">
    <div class="nav-left">
      <a href="/" class="nav-title">
        <span class="lambda-icon">λ</span> TIME-LIFE 3
      </a>
    </div>
    <div class="nav-right desktop-menu">
      <a href="/counter" class="nav-link">How much longer gabe?</a>
      <a href="/be-the-first-to-know" class="nav-link">Be the first to know</a>
      <a href="/about" class="nav-link">About</a>
      <a href="https://x.com/DaysWithoutHL3" target="_blank" class="nav-link"
        >X</a
      >
      <!-- {
                isHome && (
                    <button id="ads-toggle" class="nav-toggle">
                        ADS: <span id="ads-status">ON</span>
                    </button>
                )
            } -->
    </div>
    <button class="hamburger" id="hamburger-btn" aria-label="Menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
  <div class="mobile-menu" id="mobile-menu">
    <a href="/counter" class="mobile-nav-link">How much longer gabe?</a>
    <a href="/be-the-first-to-know" class="mobile-nav-link"
      >Be the first to know</a
    >
    <a href="/about" class="mobile-nav-link">About</a>
    <a
      href="https://x.com/DaysWithoutHL3"
      target="_blank"
      class="mobile-nav-link">X</a
    >
    <!-- {
            isHome && (
                <button id="ads-toggle-mobile" class="nav-toggle">
                    ADS: <span id="ads-status-mobile">ON</span>
                </button>
            )
        } -->
  </div>
</nav>

<script>
  let adsEnabled = false;

  function setup() {
    const adsToggle = document.getElementById("ads-toggle");
    const adsToggleMobile = document.getElementById("ads-toggle-mobile");
    const adsStatus = document.getElementById("ads-status");
    const adsStatusMobile = document.getElementById("ads-status-mobile");
    const hamburgerBtn = document.getElementById("hamburger-btn");
    const mobileMenu = document.getElementById("mobile-menu");

    function updateAdsUI() {
      document.body.classList.toggle("ads-hidden", !adsEnabled);

      if (adsStatus) adsStatus.textContent = adsEnabled ? "ON" : "OFF";
      if (adsStatusMobile)
        adsStatusMobile.textContent = adsEnabled ? "ON" : "OFF";

      if (adsToggle) adsToggle.classList.toggle("toggle-off", !adsEnabled);
      if (adsToggleMobile)
        adsToggleMobile.classList.toggle("toggle-off", !adsEnabled);
    }

    function toggleAds() {
      adsEnabled = !adsEnabled;
      updateAdsUI();
    }

    // Initialize UI state
    updateAdsUI();

    if (adsToggle) adsToggle.addEventListener("click", toggleAds);
    if (adsToggleMobile) adsToggleMobile.addEventListener("click", toggleAds);

    if (hamburgerBtn && mobileMenu) {
      hamburgerBtn.addEventListener("click", () => {
        const isOpen = mobileMenu.classList.contains("active");

        const updateMenu = () => {
          if (isOpen) {
            hamburgerBtn.classList.remove("active");
            mobileMenu.classList.remove("active");
            mobileMenu.classList.add("inactive");
            document.body.classList.remove("menu-open");
          } else {
            hamburgerBtn.classList.add("active");
            mobileMenu.classList.remove("inactive");
            mobileMenu.classList.add("active");
            document.body.classList.add("menu-open");
          }
        };

        if (document.startViewTransition) {
          document.startViewTransition(() => updateMenu());
        } else {
          updateMenu();
        }
      });

      // Close menu when clicking a link
      const mobileLinks = mobileMenu.querySelectorAll(".mobile-nav-link");
      mobileLinks.forEach((link) => {
        link.addEventListener("click", () => {
          const closeMenu = () => {
            if (mobileMenu.classList.contains("active")) {
              hamburgerBtn.classList.remove("active");
              mobileMenu.classList.remove("active");
              mobileMenu.classList.add("inactive");
              document.body.classList.remove("menu-open");
            }
          };

          if (document.startViewTransition) {
            document.startViewTransition(() => closeMenu());
          } else {
            closeMenu();
          }
        });
      });
    }
  }

  // Initialize on first load and after view transitions
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 70px;
    background: rgba(10, 6, 0, 0.4);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(212, 120, 0, 0.2);
    z-index: 1000;
    display: flex;
    align-items: center;
    padding: 0 2rem;
  }

  .nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .nav-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--hl-primary);
    text-decoration: none;
    letter-spacing: 4px;
    text-shadow: 0 0 10px rgba(212, 120, 0, 0.4);
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .lambda-icon {
    font-size: 1.8rem;
    color: var(--hl-glow);
    text-shadow: 0 0 15px rgba(255, 180, 0, 0.6);
    font-weight: normal;
    margin-top: -4px; /* Adjust for font baseline */
  }

  .nav-title:hover {
    color: var(--hl-glow);
    text-shadow: 0 0 15px rgba(255, 180, 0, 0.6);
  }

  .nav-title:hover .lambda-icon {
    transform: scale(1.1);
    filter: brightness(1.2);
  }

  .nav-right.desktop-menu {
    display: flex;
    gap: 2.5rem;
  }

  .nav-link {
    color: var(--hl-accent);
    text-decoration: none;
    text-transform: uppercase;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 2px;
    opacity: 0.7;
    transition: all 0.3s ease;
    position: relative;
    line-height: 30px;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--hl-primary);
    transition: width 0.3s ease;
    box-shadow: 0 0 5px var(--hl-primary);
  }

  .nav-link:hover {
    opacity: 1;
    color: var(--hl-primary);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .nav-toggle {
    background: rgba(212, 120, 0, 0.1);
    border: 1px solid var(--hl-secondary);
    color: var(--hl-primary);
    padding: 0.4rem 1rem;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    cursor: pointer;
    transition: all 0.3s ease;
    border-radius: 4px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-toggle:hover {
    background: rgba(212, 120, 0, 0.2);
    border-color: var(--hl-primary);
    box-shadow: 0 0 10px rgba(212, 120, 0, 0.3);
  }

  .nav-toggle.toggle-off {
    color: var(--hl-text-dim);
    border-color: rgba(160, 160, 160, 0.3);
    background: rgba(160, 160, 160, 0.05);
  }

  .nav-toggle.toggle-off #ads-status,
  .nav-toggle.toggle-off #ads-status-mobile {
    color: #ff4444;
  }

  #ads-status,
  #ads-status-mobile {
    color: #44ff44;
    transition: color 0.3s ease;
  }

  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 30px;
    height: 21px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 1001;
  }

  .hamburger span {
    width: 100%;
    height: 3px;
    background-color: var(--hl-primary);
    border-radius: 10px;
    transition: all 0.3s linear;
    position: relative;
    transform-origin: 1px;
  }

  .hamburger.active span:first-child {
    transform: rotate(45deg);
  }

  .hamburger.active span:nth-child(2) {
    opacity: 0;
    transform: translateX(20px);
  }

  .hamburger.active span:nth-child(3) {
    transform: rotate(-45deg);
  }

  .mobile-menu {
    display: none;
    position: fixed;
    top: 0;
    right: -100%;
    width: 100%;
    height: 100vh;
    background: rgba(212, 120, 0, 0.15);
    backdrop-filter: blur(15px);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    z-index: 1000;
    border-left: 1px solid rgba(212, 120, 0, 0.4);
    text-align: center;
    overflow: hidden;
  }

  .mobile-menu::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(212, 120, 0, 0.05) 50%,
      transparent
    );
    background-size: 100% 4px;
    pointer-events: none;
    opacity: 0.3;
  }

  .mobile-menu.active {
    right: 0;
    animation: menu-glitch 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
    animation-fill-mode: forwards;
    background: rgba(212, 120, 0, 0.25);
  }

  .mobile-menu.inactive {
    right: 0;
    animation: menu-glitch-reverse 0.3s cubic-bezier(0.45, 0.94, 0.25, 0.46)
      both;
    animation-delay: 0.2s;
  }

  .mobile-nav-link {
    color: #ffffff;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 1.8rem;
    font-weight: 900;
    letter-spacing: 6px;
    opacity: 1;
    transition: all 0.2s ease;
    text-shadow:
      2px 2px 0px #000,
      0 0 10px rgba(212, 120, 0, 0.8),
      0 0 20px rgba(212, 120, 0, 0.4);
    position: relative;
  }

  .mobile-menu.active .mobile-nav-link {
    animation: text-glitch 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
    animation-delay: 0.1s;
  }

  .mobile-menu.inactive .mobile-nav-link {
    animation: text-glitch-reverse 0.3s cubic-bezier(0.45, 0.94, 0.25, 0.46)
      both;
  }

  @keyframes menu-glitch {
    0% {
      transform: translate(20px, 0) skew(-10deg);
      opacity: 0;
      clip-path: inset(40% 0 60% 0);
    }
    20% {
      transform: translate(-20px, 0) skew(10deg);
      clip-path: inset(20% 0 80% 0);
    }
    40% {
      transform: translate(10px, 0) skew(-5deg);
      clip-path: inset(60% 0 20% 0);
    }
    60% {
      transform: translate(-5px, 0) skew(5deg);
      clip-path: inset(10% 0 90% 0);
    }
    80% {
      transform: translate(0, 0) skew(0);
      clip-path: inset(0 0 0 0);
      opacity: 1;
    }
    100% {
      transform: translate(0, 0) skew(0);
      clip-path: inset(0 0 0 0);
      opacity: 1;
    }
  }

  @keyframes menu-glitch-reverse {
    0% {
      transform: translate(0, 0) skew(0);
      clip-path: inset(0 0 0 0);
      opacity: 1;
    }
    20% {
      transform: translate(0, 0) skew(0);
      clip-path: inset(0 0 0 0);
      opacity: 1;
    }
    40% {
      transform: translate(-5px, 0) skew(5deg);
      clip-path: inset(10% 0 90% 0);
    }
    60% {
      transform: translate(10px, 0) skew(-5deg);
      clip-path: inset(60% 0 20% 0);
    }
    80% {
      transform: translate(-20px, 0) skew(10deg);
      clip-path: inset(20% 0 80% 0);
    }
    100% {
      transform: translate(20px, 0) skew(-10deg);
      opacity: 0;
      clip-path: inset(40% 0 60% 0);
    }
  }

  @keyframes text-glitch {
    0% {
      text-shadow:
        5px 0 0 rgba(255, 0, 0, 0.75),
        -5px 0 0 rgba(0, 255, 255, 0.75);
      transform: translate(5px, 0);
    }
    20% {
      text-shadow:
        -5px 0 0 rgba(255, 0, 0, 0.75),
        5px 0 0 rgba(0, 255, 255, 0.75);
      transform: translate(-5px, 0);
    }
    40% {
      text-shadow:
        3px 0 0 rgba(255, 180, 0, 0.75),
        -3px 0 0 rgba(0, 0, 0, 0.75);
      transform: translate(3px, 0);
    }
    100% {
      text-shadow: 2px 2px 0px rgba(212, 120, 0, 0.5);
      transform: translate(0, 0);
    }
  }

  @keyframes text-glitch-reverse {
    0% {
      text-shadow: 2px 2px 0px rgba(212, 120, 0, 0.5);
      transform: translate(0, 0);
    }
    20% {
      text-shadow:
        3px 0 0 rgba(255, 180, 0, 0.75),
        -3px 0 0 rgba(0, 0, 0, 0.75);
      transform: translate(3px, 0);
    }
    40% {
      text-shadow:
        -5px 0 0 rgba(255, 0, 0, 0.75),
        5px 0 0 rgba(0, 255, 255, 0.75);
      transform: translate(-5px, 0);
    }
    100% {
      text-shadow:
        5px 0 0 rgba(255, 0, 0, 0.75),
        -5px 0 0 rgba(0, 255, 255, 0.75);
      transform: translate(5px, 0);
    }
  }

  .mobile-nav-link:hover {
    opacity: 1;
    color: var(--hl-primary);
    text-shadow: 0 0 10px var(--hl-primary);
  }

  @media (max-width: 768px) {
    .navbar {
      padding: 0 1.5rem;
    }
    .nav-right.desktop-menu {
      display: none;
    }
    .hamburger {
      display: flex;
    }
    .mobile-menu {
      display: flex;
    }
    .nav-title {
      font-size: 1.2rem;
      letter-spacing: 2px;
    }
  }
  /* Fade out main content when menu is open */
  :global(body.menu-open) :global(main) {
    opacity: 0.1;
    filter: blur(8px) grayscale(0.5);
    transition: all 0.5s ease-in-out;
    pointer-events: none;
  }

  /* Also fade out the background grid layer if desired */
  :global(body.menu-open)::after {
    opacity: 0.1;
    transition: opacity 0.5s ease-in-out;
  }
</style>
