---
import { timelineEvents } from "../data/timeline";

const categories = ["release", "leak", "rumor", "valve", "community"];
---

<div class="timeline-container">
    <div class="filters" data-aos="fade-down">
        <button class="filter-btn active" data-filter="all">All Intel</button>
        {
            categories.map((cat) => (
                <button class="filter-btn" data-filter={cat}>
                    {cat}
                </button>
            ))
        }
    </div>

    <div class="timeline-wrapper">
        <div class="timeline-line"></div>

        <div class="events-list">
            {
                timelineEvents.map((event, index) => (
                    <div
                        class={`timeline-event ${index % 2 === 0 ? "left" : "right"}`}
                        data-type={event.type}
                        data-aos={index % 2 === 0 ? "fade-right" : "fade-left"}
                        data-aos-delay={100}
                    >
                        <div class="event-dot" />
                        <div class="event-card">
                            <div class="event-header">
                                <span class={`badge ${event.type}`}>
                                    {event.type}
                                </span>
                                <span class="event-date">{event.date}</span>
                            </div>
                            <h3 class="event-title">{event.title}</h3>
                            <p class="event-description">{event.description}</p>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</div>

<script>
    function setupFilters() {
        const buttons = document.querySelectorAll(".filter-btn");
        const events = document.querySelectorAll(".timeline-event");

        buttons.forEach((btn) => {
            btn.addEventListener("click", () => {
                // Update active button
                buttons.forEach((b) => b.classList.remove("active"));
                btn.classList.add("active");

                const filter = (btn as HTMLElement).dataset.filter;

                events.forEach((event) => {
                    const type = (event as HTMLElement).dataset.type;
                    if (filter === "all" || filter === type) {
                        (event as HTMLElement).style.display = "flex";
                        // Trigger AOS refresh if needed (AOS usually handles DOM changes if configured)
                    } else {
                        (event as HTMLElement).style.display = "none";
                    }
                });
            });
        });
    }

    document.addEventListener("astro:page-load", setupFilters);
</script>

<style>
    .timeline-container {
        width: 100%;
        max-width: 1000px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    .filters {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 4rem;
    }

    .filter-btn {
        background: rgba(10, 6, 0, 0.6);
        border: 1px solid var(--hl-secondary);
        color: var(--hl-text-dim);
        padding: 0.5rem 1rem;
        cursor: pointer;
        text-transform: uppercase;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 1px;
        transition: all 0.3s ease;
        border-radius: 4px;
    }

    .filter-btn:hover {
        border-color: var(--hl-primary);
        color: var(--hl-primary);
    }

    .filter-btn.active {
        background: var(--hl-primary);
        color: #000;
        border-color: var(--hl-primary);
        box-shadow: 0 0 15px rgba(212, 120, 0, 0.4);
    }

    .timeline-wrapper {
        position: relative;
        padding: 2rem 0;
    }

    .timeline-line {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        width: 2px;
        height: 100%;
        background: linear-gradient(
            to bottom,
            transparent,
            var(--hl-primary) 10%,
            var(--hl-primary) 90%,
            transparent
        );
        box-shadow: 0 0 10px rgba(212, 120, 0, 0.3);
    }

    .events-list {
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    .timeline-event {
        display: flex;
        width: 100%;
        position: relative;
        z-index: 1;
    }

    .event-dot {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        width: 12px;
        height: 12px;
        background: var(--hl-primary);
        border-radius: 50%;
        border: 2px solid #000;
        box-shadow: 0 0 10px var(--hl-primary);
        top: 24px;
        z-index: 2;
    }

    .event-card {
        width: 45%;
        background: rgba(10, 6, 0, 0.75);
        border: 1px solid var(--hl-secondary);
        padding: 1.5rem;
        border-radius: 8px;
        backdrop-filter: blur(10px);
        transition:
            transform 0.3s ease,
            border-color 0.3s ease;
    }

    .timeline-event.left {
        justify-content: flex-start;
    }

    .timeline-event.right {
        justify-content: flex-end;
    }

    .timeline-event:hover .event-card {
        border-color: var(--hl-primary);
        transform: translateY(-5px);
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.5);
    }

    .event-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .badge {
        font-size: 10px;
        text-transform: uppercase;
        font-weight: 900;
        padding: 2px 6px;
        border-radius: 3px;
        letter-spacing: 1px;
    }

    .badge.release {
        background: #059669;
        color: #fff;
    }
    .badge.leak {
        background: #dc2626;
        color: #fff;
    }
    .badge.rumor {
        background: #d97706;
        color: #fff;
    }
    .badge.valve {
        background: #2563eb;
        color: #fff;
    }
    .badge.community {
        background: #4b5563;
        color: #fff;
    }

    .event-date {
        font-size: 0.8rem;
        color: var(--hl-primary);
        font-weight: 700;
    }

    .event-title {
        font-size: 1.25rem;
        color: var(--hl-glow);
        margin-bottom: 0.5rem;
        letter-spacing: 0.5px;
    }

    .event-description {
        font-size: 0.9rem;
        line-height: 1.6;
        color: #ccc;
        font-weight: 300;
    }

    @media (max-width: 768px) {
        .timeline-line {
            left: 20px;
            transform: none;
        }

        .event-dot {
            left: 20px;
            transform: translateX(-50%);
        }

        .event-card {
            width: calc(100% - 60px);
            margin-left: 40px;
        }

        .timeline-event {
            justify-content: flex-start !important;
        }
    }
</style>
