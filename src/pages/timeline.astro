---
import Layout from "../layouts/Layout.astro";
import TimelineComponent from "../components/Timeline.astro";
import LeftAd from "../components/LeftAd.astro";
import RightAd from "../components/RightAd.astro";
---

<Layout
    title="Intel Log: Half-Life Chronology | Timeline of Events"
    description="A complete timeline of Half-Life releases, leaks, rumors, and official statements from 1998 to present."
    canonical="https://time-life3.com/timeline"
    showAds={false}
>
    <main>
        <LeftAd />
        <div class="center-content">
            <header class="timeline-header" data-aos="fade-up">
                <h1 class="title">
                    INTEL LOG: <span class="highlight">CHRONOLOGY</span>
                </h1>
                <p class="subtitle">
                    Accessing classified historical records from Black Mesa and
                    beyond.
                </p>
            </header>

            <TimelineComponent />
        </div>
        <RightAd />
    </main>
</Layout>

<style>
    .timeline-header {
        text-align: center;
        margin-bottom: 4rem;
        padding: 0 1rem;
    }

    .title {
        font-size: 3rem;
        letter-spacing: 4px;
        color: var(--hl-primary);
        margin-bottom: 1rem;
        text-transform: uppercase;
        text-shadow: 0 0 15px rgba(212, 120, 0, 0.4);
    }

    .highlight {
        color: #ff4444;
        text-shadow: 0 0 15px rgba(255, 68, 68, 0.5);
    }

    .subtitle {
        font-size: 1.1rem;
        color: var(--hl-text-dim);
        font-weight: 300;
        max-width: 600px;
        margin: 0 auto;
    }

    @media (max-width: 768px) {
        .title {
            font-size: 2rem;
            letter-spacing: 2px;
        }

        .timeline-header {
            margin-top: 2rem;
            margin-bottom: 2rem;
        }
    }
</style>
