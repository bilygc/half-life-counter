---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import News from "../components/News.astro";
import LeftAd from "../components/LeftAd.astro";
import RightAd from "../components/RightAd.astro";

const { HL_NEWS_TOKEN } = import.meta.env;
const isLocal = import.meta.env.DEV;

export interface Article {
  source: { id: string | null; name: string };
  author: string;
  title: string;
  description: string;
  url: string;
  urlToImage: string | null;
  publishedAt: string;
  content: string;
}

interface HLNews {
  status: string;
  totalResults: number;
  articles: Article[];
}

let articles: Article[] = [];
let error: string | null = null;

const url = isLocal
  ? "http://localhost:8080/news"
  : "https://half-life.onrender.com/news";

try {
  console.log(`>>> Attempting to fetch news from: ${url}`);

  if (!HL_NEWS_TOKEN) {
    console.warn("WARNING: HL_NEWS_TOKEN is not defined.");
  }

  const response = await fetch(url, {
    headers: {
      Authorization: `Bearer ${HL_NEWS_TOKEN}`,
      Accept: "application/json",
      "User-Agent": "Astro-App",
    },
  });

  if (!response.ok) {
    const text = await response.text();
    console.error(`>>> API Error Response (${response.status}):`, text);
    try {
      const json = JSON.parse(text);
      throw new Error(json.error || response.statusText);
    } catch {
      throw new Error(`API Error: ${response.status} ${response.statusText}`);
    }
  }

  const data = (await response.json()) as HLNews;
  articles = data.articles;
  console.log(`>>> Successfully fetched ${articles.length} articles.`);
} catch (e: any) {
  error = e.message;
  console.error(">>> Fetch Error Details:", {
    message: e.message,
    cause: e.cause, // Node 18+ fetch provides 'cause'
    code: e.code,
  });
}
---

<Layout
  title="Rumors and news about Half-Life 3 | Current status and leaks"
  description="Days since a half-life 3 game release counter"
  canonical="https://time-life3.com/"
>
  <main>
    <LeftAd />
    <div class="center-content">
      <Hero article={articles[0]} />
      <News articles={articles} error={error} />
    </div>
    <RightAd />
  </main>
</Layout>
