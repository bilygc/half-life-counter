---
import Layout from "../layouts/Layout.astro";
import EvidenceTracker from "../components/EvidenceTracker.astro";
import LeftAd from "../components/LeftAd.astro";
import RightAd from "../components/RightAd.astro";
---

<Layout
    title="Evidence Tracker | Half-Life 3 Clue Board"
    description="A classified dossier of SteamDB entries, code leaks, patent filings, and employee hints regarding Half-Life 3."
    canonical="https://time-life3.com/evidence"
    showAds={false}
>
    <main>
        <LeftAd />
        <div class="center-content">
            <header class="evidence-header" data-aos="fade-up">
                <h1 class="title">
                    CLASSIFIED DOSSIER: <span class="highlight">EVIDENCE</span>
                </h1>
                <p class="subtitle">
                    Sifting through the noise to document every verified
                    fragment of data.
                </p>
            </header>

            <EvidenceTracker />
        </div>
        <RightAd />
    </main>
</Layout>

<style>
    .evidence-header {
        text-align: center;
        margin-bottom: 4rem;
        padding: 0 1rem;
    }

    .title {
        font-size: 3rem;
        letter-spacing: 4px;
        color: var(--hl-primary);
        margin-bottom: 1rem;
        text-transform: uppercase;
        text-shadow: 0 0 15px rgba(212, 120, 0, 0.4);
    }

    .highlight {
        color: #ff4444;
        text-shadow: 0 0 15px rgba(255, 68, 68, 0.5);
    }

    .subtitle {
        font-size: 1.1rem;
        color: var(--hl-text-dim);
        font-weight: 300;
        max-width: 600px;
        margin: 0 auto;
    }

    @media (max-width: 768px) {
        .title {
            font-size: 2rem;
            letter-spacing: 2px;
        }

        .evidence-header {
            margin-top: 2rem;
            margin-bottom: 2rem;
        }
    }
</style>
