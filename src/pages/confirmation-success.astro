---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Subscription Confirmed | Half-Life 3 Alerts"
  description="Your subscription to Half-Life 3 alerts has been confirmed."
  canonical="https://time-life3.com/confirmation-success"
  showAds={false}
>
  <main>
    <div class="content-wrapper">
      <div class="lambda-container">
        <span class="lambda">λ</span>
      </div>
      <h1>Transmission Verified</h1>
      <p class="subtitle">
        Your frequency is now synced. You will receive updates as soon as they
        are detected.
      </p>

      <div class="success-card">
        <div class="success-icon">✓</div>
        <p class="success-message">
          Access Granted. You have successfully subscribed to Half-Life 3
          alerts.
        </p>
        <a href="/" class="home-link">Return to Base</a>
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  :root {
    --hl-success: #44ff44;
  }

  body {
    background-image:
      linear-gradient(rgba(10, 6, 0, 0.85), rgba(10, 6, 0, 0.85)),
      url("/lambda-bg.webp");
  }

  main {
    padding: 120px 20px 60px;
    width: 100%;
    max-width: 600px;
    z-index: 10;
    position: relative;
  }

  .content-wrapper {
    text-align: center;
  }

  .lambda-container {
    margin-bottom: 30px;
  }

  .lambda {
    font-size: 80px;
    color: var(--hl-primary);
    text-shadow: 0 0 20px var(--hl-glow);
    font-weight: 700;
  }

  h1 {
    font-size: 3rem;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--hl-primary);
  }

  .subtitle {
    color: var(--hl-text-dim);
    font-size: 1.1rem;
    margin-bottom: 3rem;
  }

  .success-card {
    background: rgba(20, 15, 5, 0.8);
    border: 1px solid var(--hl-secondary);
    padding: 40px;
    border-radius: 8px;
    backdrop-filter: blur(10px);
    text-align: center;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
  }

  .success-icon {
    font-size: 4rem;
    color: var(--hl-success);
    margin-bottom: 1.5rem;
    text-shadow: 0 0 20px rgba(68, 255, 68, 0.3);
  }

  .success-message {
    font-size: 1.2rem;
    margin-bottom: 2rem;
    line-height: 1.6;
    color: var(--hl-accent);
  }

  .home-link {
    display: inline-block;
    background: var(--hl-primary);
    color: black;
    text-decoration: none;
    padding: 14px 32px;
    border-radius: 4px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
  }

  .home-link:hover {
    background: var(--hl-glow);
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(212, 120, 0, 0.4);
  }

  @media (max-width: 480px) {
    h1 {
      font-size: 2rem;
    }
  }
</style>
